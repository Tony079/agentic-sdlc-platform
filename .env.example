# Copy to .env (git-ignored) and replace every value. Never commit real secrets.
# Generate strong values, for example:  openssl rand -hex 24

POSTGRES_PASSWORD=replace-with-a-random-superuser-password
SDLC_DB_MIGRATOR_PASSWORD=replace-with-a-random-migrator-password
SDLC_DB_APP_PASSWORD=replace-with-a-random-app-password
SDLC_DB_WORKER_PASSWORD=replace-with-a-random-worker-password
# Staff provisioning login (used only by the on-demand "provision" service).
SDLC_DB_PROVISIONER_PASSWORD=replace-with-a-random-provisioner-password
# Retention and deletion login (used only by the on-demand "retention" service).
SDLC_DB_RETENTION_PASSWORD=replace-with-a-random-retention-password
# Attachment encryption key: 32 random bytes, base64. Generate with: openssl rand -base64 32
SDLC_STORAGE_KEY=replace-with-openssl-rand-base64-32
# Staff TOTP secret encryption key: 32 random bytes, base64. Generate with: openssl rand -base64 32
SDLC_MFA_KEY=replace-with-openssl-rand-base64-32

# Development seed: demo tenants "acme" and "globex", each with a Client User and a Client Approver
# (alice@acme.test, aaron@acme.test, gina@globex.test, gary@globex.test), all with this password.
# Local development only. Leave SDLC_DEV_SEED=false anywhere else.
SDLC_DEV_SEED=true
SDLC_DEV_SEED_PASSWORD=replace-with-a-local-demo-password

# Host port for the web UI (bound to 127.0.0.1 only).
SDLC_WEB_PORT=8080

# Garuda account email (invitations and password resets, GD-04). Optional: without a host, admins copy links.
# Gmail: SDLC_MAIL_HOST=smtp.gmail.com, SDLC_MAIL_PORT=465, SDLC_MAIL_USERNAME=<the Google account>,
# SDLC_MAIL_APP_PASSWORD=<a 16-character App Password; needs 2-Step Verification>. Never commit a real value.
SDLC_PUBLIC_BASE_URL=http://localhost:8080
SDLC_MAIL_HOST=
SDLC_MAIL_PORT=465
SDLC_MAIL_USERNAME=
SDLC_MAIL_FROM=
SDLC_MAIL_APP_PASSWORD=
